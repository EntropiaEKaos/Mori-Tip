{
  "expo": {
    "name": "Mori",
    "slug": "mori-mobile",
    "version": "2.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "mori",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f11"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.mori.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Mori precisa de acesso à câmera para tirar fotos dos momentos.",
        "NSMicrophoneUsageDescription": "Mori precisa do microfone para gravar mensagens de voz.",
        "NSPhotoLibraryUsageDescription": "Mori precisa acessar suas fotos para compartilhar momentos."
      }
    },
    "android": {
      "package": "app.mori.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f0f11"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-camera",
      "expo-notifications",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "your-expo-project-id-here"
      }
    }
  }
}
